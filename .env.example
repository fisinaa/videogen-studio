# =============================================
# VideoGen Studio
# =============================================

VIDEOGEN_HOST=127.0.0.1
VIDEOGEN_PORT=8090
VIDEOGEN_PROJECTS_DIR=./data/projects


# =============================================
# LLM / Storyboard generation
# =============================================

LLM_PROVIDER=llama_cpp
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL=local
LLM_API_KEY=local
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1800


# =============================================
# Automatic model / GPU orchestration
# =============================================
# VideoGen controls llama-server through a user-level systemd unit.
# In on-demand mode:
#   first LLM request -> start llama-server
#   further LLM calls reuse it
#   idle timeout -> stop llama-server and free VRAM
#   local image/video generation -> llama-server remains stopped
#   next LLM request -> start it again automatically
#
# Install deploy/systemd/videogen-llama.service.example as:
#   ~/.config/systemd/user/videogen-llama.service
# then run:
#   systemctl --user daemon-reload
#   systemctl --user enable videogen-llama.service
# Do not keep the unit permanently started when using LLM_ON_DEMAND=true.

MODEL_ORCHESTRATION_ENABLED=true
LLM_SYSTEMD_UNIT=videogen-llama.service
LLM_ON_DEMAND=true
LLM_IDLE_TIMEOUT_SECONDS=60
LLM_RESTART_AFTER_IMAGE=true
LLM_START_TIMEOUT_SECONDS=90
LLM_STOP_TIMEOUT_SECONDS=30
GPU_LOCK_FILE=/tmp/videogen-gpu.lock


# =============================================
# Stock media search
# =============================================

PEXELS_API_KEY=
PIXABAY_API_KEY=


# =============================================
# Image routing
# =============================================
# Allowed:
#   auto
#   local
#   local_fast
#   local_quality
#   local_next
#   openai
#
# auto order:
#   local_next -> local_quality -> local_fast -> OpenAI
#
# UI buttons select a provider explicitly, so this is mainly the default
# for API calls that do not specify a provider.
#
# Character Reference defaults in UI:
#   Local Fast / Local Quality / Local Next -> OFF
#   OpenAI Final                            -> ON when a reference exists

IMAGE_PROVIDER=auto


# =============================================
# OpenAI Image + TTS fallback
# =============================================

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_SECONDS=180


# =============================================
# stable-diffusion.cpp shared runtime
# Tested host: GTX 1660 6 GB, Xeon E5-2660 v4
# =============================================

SD_CPP_BIN=/home/faa/stable-diffusion.cpp/build/bin/sd-cli

# Shared FLUX.1 files used by FAST and as fallback values for profile-specific settings.
SD_CPP_VAE=/home/faa/models/flux/ae.safetensors
SD_CPP_CLIP_L=/home/faa/models/flux/clip_l.safetensors
SD_CPP_T5XXL=/home/faa/models/flux/t5xxl_fp16.safetensors

SD_CPP_TIMEOUT_SECONDS=600

# Working runtime profile for GTX 1660 6 GB.
# Text encoder on CPU, diffusion on CUDA.
SD_CPP_BACKEND=all=cuda0,te=cpu
SD_CPP_OFFLOAD_TO_CPU=true
SD_CPP_MAX_VRAM=-1
SD_CPP_DIFFUSION_FA=true
SD_CPP_THREADS=14
SD_CPP_VERBOSE=true


# =============================================
# Local FAST image profile
# FLUX.1-schnell Q2_K
# =============================================

SD_CPP_DIFFUSION_MODEL=/home/faa/models/flux/flux1-schnell-q2_k.gguf
SD_CPP_STEPS=4
SD_CPP_CFG_SCALE=1.0
SD_CPP_SAMPLING_METHOD=euler


# =============================================
# Local QUALITY image profile
# Z-Image-Turbo Q3_K + Qwen3-4B Q4_K_M
# =============================================
# Expected files:
#   /home/faa/models/z-image/z_image_turbo-Q3_K.gguf
#   /home/faa/models/z-image/Qwen3-4B-Instruct-2507-Q4_K_M.gguf

SD_CPP_QUALITY_DIFFUSION_MODEL=/home/faa/models/z-image/z_image_turbo-Q3_K.gguf
SD_CPP_QUALITY_VAE=/home/faa/models/flux/ae.safetensors
SD_CPP_QUALITY_LLM=/home/faa/models/z-image/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
SD_CPP_QUALITY_CLIP_L=
SD_CPP_QUALITY_T5XXL=

SD_CPP_QUALITY_STEPS=8
SD_CPP_QUALITY_CFG_SCALE=1.0
SD_CPP_QUALITY_SAMPLING_METHOD=euler


# =============================================
# Local NEXT profile
# FLUX.2 Klein 4B Q4_0 + Qwen3-4B Q4_K_M
# =============================================

SD_CPP_NEXT_DIFFUSION_MODEL=/home/faa/models/flux2/flux-2-klein-4b-Q4_0.gguf
SD_CPP_NEXT_VAE=/home/faa/models/flux2/full_encoder_small_decoder.safetensors
SD_CPP_NEXT_LLM=/home/faa/models/flux2/Qwen3-4B-Q4_K_M.gguf
SD_CPP_NEXT_CLIP_L=
SD_CPP_NEXT_T5XXL=

SD_CPP_NEXT_STEPS=4
SD_CPP_NEXT_CFG_SCALE=1.0
SD_CPP_NEXT_SAMPLING_METHOD=euler


# =============================================
# Local image output sizes
# =============================================

SD_CPP_WIDTH_16_9=768
SD_CPP_HEIGHT_16_9=432
SD_CPP_WIDTH_9_16=432
SD_CPP_HEIGHT_9_16=768
SD_CPP_WIDTH_1_1=512
SD_CPP_HEIGHT_1_1=512


# =============================================
# Legacy stable-diffusion.cpp compatibility
# =============================================

SD_CPP_CLIP_ON_CPU=true


# =============================================
# AI Motion / image-to-video
# =============================================

MOTION_PROVIDER=openmontage
MOTION_TIMEOUT_SECONDS=3600
MOTION_DEFAULT_DURATION_SECONDS=10
MOTION_MAX_DURATION_SECONDS=12
MOTION_OPENMONTAGE_PREFERRED_PROVIDER=auto
MOTION_OPENMONTAGE_RUNNER=./scripts/openmontage_motion.py
MOTION_OPENMONTAGE_RESERVE_GPU=false
FAL_KEY=


# =============================================
# TTS routing
# =============================================

TTS_PROVIDER=auto

OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_INSTRUCTIONS=Speak naturally in Russian with warm cinematic narration, clear diction, moderate pace, and no exaggerated announcer style.
OPENAI_TTS_TIMEOUT_SECONDS=180

PIPER_BIN=/opt/piper/venv/bin/piper
PIPER_MODEL=/opt/piper/models/ru_RU-irina-medium.onnx
PIPER_TIMEOUT_SECONDS=120


# =============================================
# OpenMontage rendering
# =============================================

OPENMONTAGE_ROOT=/home/faa/OpenMontage
OPENMONTAGE_PYTHON=/home/faa/OpenMontage/.venv/bin/python
OPENMONTAGE_TIMEOUT_SECONDS=3600
VIDEOGEN_OPENMONTAGE_RUNNER=./scripts/openmontage_render.py

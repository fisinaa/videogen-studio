[Unit]
Description=VideoGen llama.cpp server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/faa/llama.cpp
ExecStart=/home/faa/llama.cpp/build/bin/llama-server -m /home/faa/models/Qwen3-8B-abliterated.Q4_K_M.gguf -ngl 38 -c 4096 -ctk q8_0 -ctv q8_0 --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
